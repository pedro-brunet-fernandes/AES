RTL_DIR := ../../frontend/rtl
RTL_FILES := \
  $(RTL_DIR)/minisoc_aes/minisoc_aes_key_exp.sv \
  $(RTL_DIR)/minisoc_aes/minisoc_aes_dp.sv \
  $(RTL_DIR)/minisoc_aes/minisoc_aes_top.sv \
  $(RTL_DIR)/minisoc_mem/minisoc_memory.sv \
  $(RTL_DIR)/minisoc_pll/minisoc_pll_mock.sv \
  $(RTL_DIR)/minisoc_spi/minisoc_spi.sv \
  $(RTL_DIR)/minisoc_top.sv

TB_INTERFACES := \
  agents/clock_agent/clock_if.sv \
  agents/reset_agent/reset_if.sv
TB_PACKAGES := \
  agents/clock_agent/clock_pkg.sv \
  agents/reset_agent/reset_pkg.sv \
  env/minisoc_env_pkg.sv \
  tests/minisoc_test_pkg.sv
TB_TOP := top_assertions.sv top_tb.sv
TB_FILES := $(TB_INTERFACES) $(TB_PACKAGES) $(TB_TOP)

TB_INCDIRS := \
  +incdir+agents/clock_agent \
  +incdir+agents/reset_agent \
  +incdir+env +incdir+sequences +incdir+tests

VCS_KDB := -kdb
VCS_DEBUG := -debug_access+all
VCS_BASE_FLAGS := -full64 -sverilog -ntb_opts uvm-1.2 \
  $(VCS_KDB) $(VCS_DEBUG) -timescale=1ns/1ps $(VCS_EXTRA_FLAGS)
# Binario separado impede executar por engano simv sem instrumentacao.
COVERAGE ?= 0
COV_DIR ?= coverage/stage1.vdb
COV_METRICS ?= line+cond+branch+tgl+fsm+assert
ifeq ($(COVERAGE),1)
SIMV := simv_cov
COV_FLAGS := -cm $(COV_METRICS) -cm_dir $(COV_DIR)
COV_RUN_FLAGS = $(COV_FLAGS) -cm_name $(UVM_TESTNAME)_$(SEED)
VCS_BUILD_FLAGS := -Mdir=csrc_cov
else
SIMV := simv
COV_FLAGS :=
COV_RUN_FLAGS :=
VCS_BUILD_FLAGS := -Mdir=csrc
endif
VCS_FLAGS := $(VCS_BASE_FLAGS) $(VCS_BUILD_FLAGS) $(COV_FLAGS) -l vcs_logger.log

SEED ?= 1
UVM_TESTNAME ?= minisoc_smoke_test

.PHONY: vcs_comp
vcs_comp:
ifeq ($(COVERAGE),1)
	@mkdir -p $(dir $(COV_DIR))
endif
	vcs $(VCS_FLAGS) $(TB_INCDIRS) $(RTL_FILES) $(TB_FILES) -top top_tb -o $(SIMV)
