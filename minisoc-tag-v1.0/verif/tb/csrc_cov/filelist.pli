PLI_STUB_OBJS_OBJ1=_vcs_pli_stub_.o
PLI_STUB_OBJS_SRC1=_vcs_pli_stub_.c
PLI_STUB_OBJS += $(PLI_STUB_OBJS_OBJ1)
$(PLI_STUB_OBJS_OBJ1): $(PLI_STUB_OBJS_SRC1)
	@$(CC) -I/Tools/synopsys/vcs/X-2025.06-SP2/include  -pipe -DVCSMX -DUVM_DPI_DO_TYPE_CHECK -fPIC -I/Tools/synopsys/vcs/X-2025.06-SP2/include     -fno-strict-aliasing -fno-optimize-sibling-calls  -fPIC -c -o $(PLI_STUB_OBJS_OBJ1) $(PLI_STUB_OBJS_SRC1)
	@strip -g $(PLI_STUB_OBJS_OBJ1)
